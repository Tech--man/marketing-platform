<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.marketing</groupId>
        <artifactId>marketing-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>marketing-gateway</artifactId>
    <name>marketing-gateway</name>
    <description>API 网关：路由、Token 鉴权、Redis+Lua 滑动窗口限流（秒杀独立限流分组）</description>

    <dependencies>
        <!-- 只为复用 AdminTokenCodec：网关与后台必须共用同一套签名实现，
             两份实现漂移的后果是"后台签的 token 网关认不出来"或反过来。
             common 的 web/jdbc/redis 全是 optional，不会被拖进这个 WebFlux 进程
             （starter-web 一旦进网关，Spring Cloud Gateway 直接启动失败）；
             common 的自动装配整体 @ConditionalOnBean(DataSource)，网关无库 → 不生效。 -->
        <dependency>
            <groupId>com.example.marketing</groupId>
            <artifactId>marketing-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Nacos 服务发现：默认关闭（local profile 静态路由），启用 nacos profile 时开启 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <!-- fat jar 用 -exec classifier：主构件保持 thin jar，供 standalone 聚合依赖 -->
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
